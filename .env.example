PORT=3000

# --- API Key (choose one approach) ---

# Option A: Encrypted (recommended)
# 1. Set ENCRYPTION_KEY in Hostinger's environment variables panel (not in this file)
# 2. Run: ENCRYPTION_KEY=your_key node scripts/encrypt-key.js sk-ant-api03-...
# 3. Paste the output below:
ENCRYPTED_API_KEY=

# Option B: Plain text (simpler, less secure)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_secret

# --- Login credentials ---
ADMIN_USERNAME=admin
# SHA-256 hash of your password. Generate with:
#   node -e "const{createHash}=require('crypto');console.log(createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_PASSWORD_HASH=your_sha256_hash_here
